{
    "name": "virtual-machine-manager",
    "version": "0.1.0",
    "description": "A fast, good-looking desktop manager for QEMU virtual machines on Windows.",
    "main": "./out/main/index.js",
    "license": "MIT",
    "private": true,
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "start": "electron-vite preview",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:qemu": "cross-env QEMU_IT=1 vitest run"
    },
    "devDependencies": {
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "cross-env": "^10.1.0",
        "electron": "^45.4.1",
        "electron-vite": "^6.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.1"
    },
    "dependencies": {
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    }
}
