{
    "name": "virtual-machine-manager",
    "version": "0.2.0",
    "description": "A fast, good-looking desktop manager for QEMU virtual machines on Windows.",
    "main": "./out/main/index.js",
    "license": "MIT",
    "private": true,
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "start": "electron-vite preview",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:qemu": "cross-env QEMU_IT=1 vitest run",
        "dev:web": "vite --config vite.web.config.mts",
        "dist": "electron-vite build && electron-builder --win nsis --publish never"
    },
    "devDependencies": {
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "cross-env": "^10.1.0",
        "electron": "^45.4.1",
        "electron-builder": "^26.18.0",
        "electron-vite": "^6.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.1"
    },
    "dependencies": {
        "lucide-react": "^1.78.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "build": {
        "appId": "io.github.a21devs.vmmanager",
        "productName": "Virtual Machine Manager",
        "directories": {
            "output": "release",
            "buildResources": "resources"
        },
        "files": [
            "out/**/*",
            "resources/**/*",
            "package.json"
        ],
        "icon": "resources/icon.png",
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "artifactName": "Virtual-Machine-Manager-Setup-${version}.${ext}",
            "icon": "resources/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "shortcutName": "Virtual Machine Manager"
        }
    }
}
